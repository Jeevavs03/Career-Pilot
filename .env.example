# CareerPilot AI - 100% Local, Zero Cost
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB (Local)
MONGODB_URI=mongodb://localhost:27017/careerpilot

# PostgreSQL (Local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careerpilot

# Redis (Local)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (Local secrets)
JWT_SECRET=careerpilot-local-jwt-secret-key-2024
JWT_REFRESH_SECRET=careerpilot-local-refresh-secret-key-2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_FALLBACK_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# Hardware Mode: low | medium | high
HARDWARE_MODE=medium

# Scheduler (IST)
SCHEDULER_MORNING=0 8 * * *
SCHEDULER_EVENING=0 20 * * *
SCHEDULER_TZ=Asia/Kolkata

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Frontend
FRONTEND_URL=http://localhost:5173

# Reports (local storage)
REPORTS_DIR=./reports

# Email (optional - leave empty for local reports only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
